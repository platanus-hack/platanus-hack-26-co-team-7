{
  "expo": {
    "name": "Replica",
    "slug": "ziro",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "../project-logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "../project-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d0d0d"
    },
    "android": {
      "package": "com.ziro.relay",
      "adaptiveIcon": {
        "foregroundImage": "../project-logo.png",
        "backgroundColor": "#0d0d0d"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "ff18bdac-3d32-4b2d-9c85-fe9eff4e493c"
      }
    }
  }
}
