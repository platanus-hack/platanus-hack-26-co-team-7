<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything the radio needs, declared HERE and not in app.json.

  A local Expo module gets its manifest merged into the app during prebuild, so no
  config plugin is required to add permissions or a service. That is the main reason
  this is a local module and not a hand-rolled TurboModule.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Nearby Connections: legacy Bluetooth, only up to API 30. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Nearby Connections: Android 12+ runtime Bluetooth permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        tools:targetApi="s" />

    <!-- Nearby Connections: Wi-Fi Direct / hotspot upgrade path. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- Still required on API 29-32 for BLE discovery. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!--
      Android 14+ THROWS on startForeground() without a typed permission matching the
      service's foregroundServiceType. Do not remove either half while debugging a crash.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
      The presence heartbeat repeats with fresh coordinates while the app is backgrounded,
      so the service tracks location too. On Android 14+ every foregroundServiceType needs
      its matching typed permission or startForeground() throws at runtime.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application>
        <service
            android:name="com.ziro.relay.adapters.service.RelayForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location" />
        <receiver
            android:name="androidx.work.impl.background.systemalarm.RescheduleReceiver"
            android:exported="false" />
    </application>
</manifest>
