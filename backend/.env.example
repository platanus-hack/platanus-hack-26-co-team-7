# Replica backend — copy to backend/.env and fill real values (never committed).
# The backend FAILS TO START without this file / env var; only PostgreSQL is supported at runtime.

DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/replica
BACKEND_CORS_ORIGINS=http://localhost:5173

# AI report narration (empty key -> deterministic fallback template)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
GOV_DEPARTMENT=CUNDINAMARCA

# EMSC near-real-time earthquake trigger (trigger_emsc). Disabled by default:
# the listener only connects when EMSC_ENABLED is truthy (1/true/yes).
EMSC_ENABLED=false
EMSC_URL=wss://www.seismicportal.eu/standing_order/websocket
EMSC_MIN_MAG=5.0
# Colombia box (lat 0..14, lon -80..-66)
EMSC_MIN_LAT=0.0
EMSC_MAX_LAT=14.0
EMSC_MIN_LON=-80.0
EMSC_MAX_LON=-66.0
