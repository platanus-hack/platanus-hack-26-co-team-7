# Replica backend — copy to backend/.env and fill real values (never committed).
# The backend FAILS TO START without this file / env var; only PostgreSQL is supported at runtime.

DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/replica
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# Private mobile authentication. Generate distinct random values of 32+ chars.
AUTH_JWT_SECRET=
AUTH_REFRESH_TOKEN_PEPPER=
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Demo-only activation. The private endpoint remains disabled unless this is exactly true.
DEMO_TRIGGER_ENABLED=false

# Public web demo trigger (POST /api/v1/demo/trigger), used by the dashboard
# button to stand in for the EMSC/SGC pollers during a presentation. It is
# UNAUTHENTICATED and rebuilds the demo event, so leave it false outside a
# local demo.
DEMO_WEB_TRIGGER_ENABLED=false

# AI report narration. LLM_* names win; HUGGINGFACE_* are accepted as aliases so
# a provider's own env block can be pasted in unchanged. The API URL may be the
# base or the full /chat/completions endpoint.
# HUGGINGFACE_API_KEY=
# HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-V3.2:novita
# HUGGINGFACE_API_URL=https://router.huggingface.co/v1/chat/completions
# HUGGINGFACE_MAX_TOKENS=700
# HUGGINGFACE_TIMEOUT_MS=30000

# AI report narration (empty key -> deterministic fallback template)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
# Required to enable POST /internal/v1/reports/generate. Generate a distinct
# random value of 32+ characters; leaving it empty disables the endpoint.
INTERNAL_REPORTS_API_KEY=
GOV_DEPARTMENT=CUNDINAMARCA

# EMSC near-real-time earthquake trigger (trigger_emsc). Disabled by default:
# the listener only connects when EMSC_ENABLED is truthy (1/true/yes).
EMSC_ENABLED=false
EMSC_URL=wss://www.seismicportal.eu/standing_order/websocket
EMSC_MIN_MAG=5.0
# Colombia box (lat 0..14, lon -80..-66)
EMSC_MIN_LAT=0.0
EMSC_MAX_LAT=14.0
EMSC_MIN_LON=-80.0
EMSC_MAX_LON=-66.0

# SGC (Servicio Geológico Colombiano) earthquake trigger (trigger_sgc). Disabled
# by default: the poller only fetches when SGC_ENABLED is truthy (1/true/yes).
SGC_ENABLED=false
SGC_URL=https://archive.sgc.gov.co/feed/v1.0.1/summary/five_days_all.json
SGC_POLL_INTERVAL_S=60
SGC_MIN_MAG=4.5
# Same Colombia box as EMSC (lat 0..14, lon -80..-66) for borough consistency
SGC_MIN_LAT=0.0
SGC_MAX_LAT=14.0
SGC_MIN_LON=-80.0
SGC_MAX_LON=-66.0

# Automatic AI report delivery (ai_reports.scheduler). Disabled by default:
# when enabled, first report as soon as the open event has aggregated cells,
# then one every AI_REPORT_EVERY_MINUTES during AI_REPORT_WINDOW_HOURS.
AI_REPORTS_ENABLED=false
AI_REPORT_SCHEDULER_INTERVAL_S=15
AI_REPORT_EVERY_MINUTES=30
AI_REPORT_WINDOW_HOURS=6

# H3 spatial aggregation (gateway_sync.aggregator). Disabled by default: when
# enabled, it rebuilds received_cells (heatmap + AI report input) for the latest
# open event every AGGREGATOR_INTERVAL_S from the ingested gateway telegrams.
AGGREGATOR_ENABLED=false
AGGREGATOR_INTERVAL_S=30
