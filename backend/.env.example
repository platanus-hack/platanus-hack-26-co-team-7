# Replica backend — copy to backend/.env and fill real values (never committed).
# The backend FAILS TO START without this file / env var; only PostgreSQL is supported at runtime.

DATABASE_URL=postgresql+psycopg://postgres:admin@localhost:5432/replica
BACKEND_CORS_ORIGINS=http://localhost:5173

# AI report narration (empty key -> deterministic fallback template)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
GOV_DEPARTMENT=CUNDINAMARCA
